# Signal Board environment variables.
# Copy this file to .env for local use (`vercel dev`), and add the same values
# in Vercel: Project → Settings → Environment Variables.
# Never commit .env — it is listed in .gitignore.

# Required for the Claude features (Read with Claude, Brief me)
ANTHROPIC_API_KEY=

# Recommended: visitors must enter this once before using the Claude features
APP_PASSCODE=

# Optional model overrides
ANTHROPIC_MODEL=claude-sonnet-5
ANTHROPIC_MODEL_QUICK=claude-haiku-4-5-20251001
